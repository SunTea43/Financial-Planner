<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm mt-5">
      <div class="card-body p-4">
        <h2 class="card-title text-center mb-4"><%= I18n.t('devise.sessions.new.sign_in', default: 'Iniciar Sesión') %></h2>

        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="form-inputs mb-3" data-controller="password-visibility">
            <%= f.input :email,
                        required: false,
                        autofocus: true,
                        input_html: {
                          autocomplete: "username",
                          value: resource.email.presence || params.dig(resource_name, :email)
                        } %>
            <%= f.input :password,
                        required: false,
                        input_html: {
                          autocomplete: "current-password",
                          data: { password_visibility_target: "input" }
                        } %>
            <div class="mb-3">
              <button type="button"
                      class="btn btn-outline-secondary btn-sm"
                      data-action="click->password-visibility#toggle"
                      data-password-visibility-target="toggle"
                      data-show-text="<%= I18n.t('devise.shared.links.show_password', default: 'Mostrar contraseña') %>"
                      data-hide-text="<%= I18n.t('devise.shared.links.hide_password', default: 'Ocultar contraseña') %>">
                <%= I18n.t("devise.shared.links.show_password", default: "Mostrar contraseña") %>
              </button>
            </div>
            <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
          </div>

          <div class="form-actions d-grid gap-2 mb-3">
            <%= f.button :submit, I18n.t('devise.sessions.new.sign_in', default: "Iniciar Sesión"), class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <div class="text-center mt-3">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
